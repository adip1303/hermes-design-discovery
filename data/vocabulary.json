{
  "version": 2,
  "about": "Maps words non-designers use to directional design moves. Moves are ranges, not exact values, so three directions can differ while honoring the same word. Type moves name font classes, not fonts. Feel words override domain defaults.",
  "hue_wheel_degrees": {
    "red": 0, "orange": 30, "yellow": 55, "green": 120,
    "teal": 175, "blue": 215, "violet": 265, "magenta": 310
  },
  "composition_steps": [
    "Pick the mode. Light by default. Dark when the user's words call for it (moody, cinematic, night, dark mode) or when a direction deliberately offers the contrast. Varying mode across three directions is a legitimate difference.",
    "Pick the neutral hue from temperature words. Warm: 20 to 50. Cool: 190 to 230. Neutral: any hue at saturation under 4%.",
    "Background. Light mode: lightness 93 to 98. Dark mode: lightness 5 to 12. Neutral saturation 3 to 12% (tinted), up to 20% only when the word asks for color in the ground (sunny, botanical, pastel).",
    "Surface. Same hue as background, 2 to 5 lightness points away. In light mode surface may be lighter (white cards) or darker (tinted panels). Pick one and keep it.",
    "Text. Same hue family as background, saturation under 20%. Light mode lightness 8 to 18, dark mode 88 to 95. Aim for 10:1 or more against background.",
    "Muted. Same hue family. Must reach 4.5:1 on both background and surface.",
    "Border. 8 to 14 lightness points from surface. Border strong must reach 3:1 on background.",
    "Accent. One accent, from the register and color words. It must reach at least 3:1 on background. Code decides whether it can carry text.",
    "Status colors are not yours. Code derives success, warning and danger for the mode and background. Never compose them.",
    "Check the anti-pattern list before submitting."
  ],
  "difference_axes": [
    "value: light, mid-tone or dark ground",
    "temperature: warm, neutral or cool neutrals",
    "accent family: which hue carries the primary action",
    "saturation: muted versus vivid",
    "type voice: serif versus sans, or quiet versus characterful display"
  ],
  "difference_rule": "Each pair of directions must differ on at least one axis a non-designer would name. Sharing a word does not mean sharing a palette. Warm can be warm white with a terracotta accent, a sand ground with an olive accent, or an espresso dark ground with an amber accent.",
  "combining_order": ["avoid", "constraints", "domain", "feel"],
  "combining_rule": "Apply things the user said to avoid, then fixed constraints, then domain, then feel words. When two words pull in opposite directions, apply the matching conflict rule's resolution rather than averaging.",
  "font_classes": {
    "neo-grotesk": { "reads_as": "neutral, engineered, contemporary", "typical_role": "UI, body, technical display" },
    "geometric-sans": { "reads_as": "clean, modern, constructed", "typical_role": "display, friendly UI" },
    "humanist-sans": { "reads_as": "warm, readable, human", "typical_role": "body, approachable UI" },
    "rounded-sans": { "reads_as": "soft, friendly, young", "typical_role": "display and UI for playful or kids" },
    "grotesk-display": { "reads_as": "characterful, bold, quirky", "typical_role": "display only" },
    "transitional-serif": { "reads_as": "trustworthy, institutional, readable", "typical_role": "body and display" },
    "oldstyle-serif": { "reads_as": "literary, warm, crafted", "typical_role": "body and display" },
    "high-contrast-serif": { "reads_as": "elegant, luxurious, dramatic", "typical_role": "display only, large sizes" },
    "soft-serif": { "reads_as": "warm, friendly, editorial but gentle", "typical_role": "display and body" },
    "slab-serif": { "reads_as": "sturdy, confident, retro, rugged", "typical_role": "display" },
    "monospace": { "reads_as": "technical, precise, raw", "typical_role": "code and data only, unless the word asks for it" }
  },
