{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "summary", "not", "traits", "use_when", "avoid_when", "internal_refs", "design_notes", "typography", "color", "layout", "geometry", "motion", "voice"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" }, "name": { "type": "string", "minLength": 1 }, "summary": { "type": "string" }, "not": { "type": "string" },
    "traits": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "../enums.json#/$defs/trait" } },
    "use_when": { "type": "string" }, "avoid_when": { "type": "string" }, "internal_refs": { "type": "array", "items": { "type": "string" } }, "design_notes": { "type": "string" }, "accent_usage": { "type": "string", "enum": ["text_and_fill", "fill_only"], "default": "text_and_fill" },
    "typography": { "type": "object", "additionalProperties": false, "required": ["display_font", "body_font", "mono_font", "scale", "weight_contrast", "case", "tracking_display"], "properties": {
      "display_font": { "type": "string" }, "body_font": { "type": "string" }, "ui_font": { "type": ["string", "null"] }, "mono_font": { "type": ["string", "null"] }, "scale": { "$ref": "../enums.json#/$defs/type_scale_id" }, "weight_contrast": { "$ref": "../enums.json#/$defs/weight_contrast" }, "case": { "type": "string" }, "tracking_display": { "type": "string" }
    } },
    "color": { "type": "object", "additionalProperties": false, "required": ["mode", "background", "surface", "text", "muted", "border", "border_strong", "accent", "accent_text", "accent_alternates", "success", "warning", "danger", "focus"], "properties": {
      "mode": { "$ref": "../enums.json#/$defs/mode" }, "background": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }, "surface": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }, "text": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }, "muted": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }, "border": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }, "border_strong": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }, "accent": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }, "accent_text": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }, "accent_alternates": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" } }, "success": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }, "warning": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }, "danger": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }, "focus": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
    } },
    "layout": { "type": "object", "additionalProperties": false, "required": ["density"], "properties": { "density": { "$ref": "../enums.json#/$defs/density" } } },
    "geometry": { "type": "object", "additionalProperties": false, "required": ["radius", "border", "elevation"], "properties": { "radius": { "$ref": "../enums.json#/$defs/radius" }, "border": { "$ref": "../enums.json#/$defs/border" }, "elevation": { "$ref": "../enums.json#/$defs/elevation" } } },
    "motion": { "type": "object", "additionalProperties": false, "required": ["preset"], "properties": { "preset": { "$ref": "../enums.json#/$defs/motion_preset" } } },
    "voice": { "type": "object", "additionalProperties": false, "required": ["tone", "do", "dont", "example"], "properties": { "tone": { "type": "string" }, "do": { "type": "array", "items": { "type": "string" } }, "dont": { "type": "array", "items": { "type": "string" } }, "example": { "type": "string" } } }
  }
}
